# Copy to .env and change the secrets before any non-demo use.
MEDRAG_MODE=offline                 # offline | real
MEDRAG_SECRET_KEY=change-me-long-random-string
MEDRAG_PATIENT_SALT=change-me-another-long-random-string
MEDRAG_SEED_DEMO=1                  # create demo users on first start (set 0 in production)

# Knowledge-base folders (comma-separated). Default: sample corpus + PubMed Central CC BY corpus.
# MEDRAG_KB_DIR=data/knowledge_base,data/knowledge_base_pmc,data/knowledge_base_local

# --- real mode ---
# GPU:   docker compose --profile gpu up   (vLLM serves the model at http://vllm:8001/v1)
# CPU:   medrag llm-server --model Qwen/Qwen2.5-VL-3B-Instruct --port 8001   (slow but works anywhere)
# MEDRAG_LLM_URL=http://localhost:8001/v1
# MEDRAG_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# MEDRAG_VERIFIER=nli                         # nli (default in real mode) | lexical
# MEDRAG_NLI_MODEL=cross-encoder/nli-deberta-v3-small
# MEDRAG_EMBED_MODEL=BAAI/bge-m3
# MEDRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# MEDRAG_IMAGE_ENCODER=hf-hub:microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
# MEDRAG_VECTOR_BACKEND=qdrant
# MEDRAG_QDRANT_URL=http://qdrant:6333
# MEDRAG_SIM_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
